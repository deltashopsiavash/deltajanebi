DOMAIN=shop.example.com
ACME_EMAIL=admin@example.com
DJANGO_SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=shop.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://shop.example.com
POSTGRES_DB=deltajanebi
POSTGRES_USER=deltajanebi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://deltajanebi:change-me@db:5432/deltajanebi

# کلید مستقل اتصال ربات خارجی به همین سایت
DELTAJANEBI_BOT_API_KEY=change-me-long-random-key

# ایمیل تراکنشی با Resend SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=DeltaJanebi <support@mail.shop.example.com>

# سازگاری با نصب‌های قدیمی؛ در نصب تازه لازم نیست مقداردهی شوند.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=

# سایت‌های منبع از داخل ربات/پنل مدیریت ثبت می‌شوند.
SOURCE_ALLOWED_HOSTS=
SOURCE_SYNC_INTERVAL=1800
SOURCE_SYNC_DELAY=1.2
SOURCE_REQUEST_TIMEOUT=20
SOURCE_USER_AGENT=DeltaJanebiSync/1.0
SOURCE_BRAND_TERMS=همراه دوم,hamrahedovom

STORE_NAME=دلتا جانبی
STORE_PHONE=
STORE_CARD_NUMBER=
STORE_CARD_OWNER=

# فقط برای اجرای اختیاری ربات legacy داخل همان سرور؛ نصب تازه از ربات خارجی استفاده می‌کند.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_STORE_CHAT_ID=
